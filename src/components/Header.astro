---
import { NAV, SITE } from "../consts";

const path = Astro.url.pathname;
const isActive = (href: string) => href.startsWith("/") && path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-bg">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="font-display text-[1.05rem] font-semibold tracking-tight [font-stretch:88%]" aria-label={`${SITE.name}, home`}>
      <span class="hidden sm:inline">{SITE.name}</span>
      <span class="sm:hidden">MSI</span><span class="text-accent">.</span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-4 sm:gap-7">
      {
        NAV.map((item) => (
          <a href={item.href} class="label link" aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <a href={SITE.contact} target="_blank" rel="noopener" class="label hidden items-center gap-2.5 text-fg lg:inline-flex">
      <span class="dot"></span>
      Open to roles
    </a>
  </div>
</header>
