---
import Split from "./Split.astro";
import { SITE, SOCIALS } from "../consts";

const year = new Date().getFullYear();
---

<footer id="contact" class="mt-28 border-t border-line md:mt-40">
  <div class="wrap pt-16 pb-8 md:pt-24">
    <p class="label" data-reveal>Contact</p>
    <a href={SITE.contact} target="_blank" rel="noopener" class="group mt-6 inline-flex items-end gap-[0.18em] display display-xl">
      <Split text="Let's talk." />
      <span
        class="mb-[0.08em] inline-block text-accent transition-transform duration-700 ease-expo group-hover:translate-x-[0.12em] group-hover:-translate-y-[0.12em]"
        aria-hidden="true">↗</span
      >
    </a>
    <div class="mt-10 grid gap-8 md:grid-cols-12">
      <p class="max-w-[44ch] text-muted md:col-span-6" data-reveal>
        I'm open to software engineering, developer-experience and solutions engineering roles, remote or on-site in
        Southern Ontario. LinkedIn is
        the fastest way to reach me.
      </p>
      <div class="md:col-span-6 md:text-right" data-reveal style="--d:80ms">
        <a href={SITE.contact} target="_blank" rel="noopener" class="link text-[1.05rem]">Message me on LinkedIn ↗</a>
      </div>
    </div>

    <div class="mt-20 flex flex-col gap-5 border-t border-line pt-6 md:flex-row md:items-center md:justify-between">
      <ul class="flex flex-wrap gap-x-7 gap-y-2">
        {
          SOCIALS.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener" class="label link">
                {social.label} ↗
              </a>
            </li>
          ))
        }
        <li><a href="/rss.xml" class="label link">RSS</a></li>
      </ul>
      <p class="label">
        {SITE.location} · <span data-clock={SITE.timeZone}>--:--</span> local
      </p>
      <p class="label">© {year} {SITE.name}</p>
    </div>
  </div>
</footer>
