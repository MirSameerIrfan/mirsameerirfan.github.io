---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Split from "../../components/Split.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const dateFormat = new Intl.DateTimeFormat("en-CA", { year: "numeric", month: "short", day: "numeric" });
---

<Base title="Writing" description="Notes on algorithms, web development and debugging by Mir Sameer Irfan.">
  <section class="wrap pt-16 md:pt-24">
    <p class="label" data-reveal>Writing ({String(posts.length).padStart(2, "0")})</p>
    <Split as="h1" class="display display-xl mt-6" text="Notes." />
    <ul class="mt-16 border-t border-line md:mt-24">
      {
        posts.map((post, i) => (
          <li data-reveal style={`--d:${i * 80}ms`}>
            <a href={`/blog/${post.id}/`} class="group grid gap-3 border-b border-line py-9 md:grid-cols-12 md:gap-6">
              <span class="label pt-2 md:col-span-3">{dateFormat.format(post.data.pubDate)}</span>
              <span class="md:col-span-8">
                <span class="display display-md block transition-colors duration-300 group-hover:text-accent" transition:name={`post-title-${post.id}`}>
                  {post.data.title}
                </span>
                <span class="mt-3 block max-w-[56ch] text-[0.95rem] text-muted">{post.data.description}</span>
              </span>
              <span class="hidden pt-2 text-right text-xl transition-transform duration-500 ease-expo group-hover:translate-x-1 group-hover:-translate-y-1 md:block" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
