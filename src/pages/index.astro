---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Split from "../components/Split.astro";
import Scrub from "../components/Scrub.astro";
import WorkList from "../components/WorkList.astro";
import { EXPERIENCE, FOCUS, SITE, TOOLKIT } from "../consts";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tools = TOOLKIT.flatMap((group) => group.items);
const count = (n: number) => `(${String(n).padStart(2, "0")})`;
const dateFormat = new Intl.DateTimeFormat("en-CA", { year: "numeric", month: "short" });
---

<Base>
  <section class="relative isolate overflow-hidden">
    <canvas
      data-dots
      aria-hidden="true"
      class="absolute inset-0 -z-10 h-full w-full [mask-image:radial-gradient(120%_100%_at_95%_0%,#000_30%,transparent_80%)]"
    ></canvas>
    <div class="wrap flex min-h-[calc(100svh-4rem)] flex-col justify-between gap-14 pt-8 pb-10 md:pt-12">
      <div class="label flex flex-wrap justify-between gap-x-6 gap-y-1" data-reveal>
        <span>{SITE.role}</span>
        <span>
          {SITE.location} · <span data-clock={SITE.timeZone}>--:--</span> local
        </span>
      </div>

      <div>
        <Split
          as="h1"
          class="display display-xl max-w-[21ch]"
          text="I build software, and debug the AI integrations engineers get stuck on."
          accent={["debug"]}
        />
        <div class="mt-10 grid items-end gap-8 md:mt-14 md:grid-cols-12">
          <p class="max-w-[46ch] text-[1.05rem] text-muted md:col-span-6" data-reveal style="--d:550ms">
            I'm Sameer, an engineer at Accenture working on an enterprise AI platform. I take production failures to root
            cause across code, containers and databases, and I build the tooling around that work: Python triage scripts
            and a multi-agent incident investigation system.
          </p>
          <div class="flex flex-wrap gap-3 md:col-span-6 md:justify-end" data-reveal style="--d:650ms">
            <a href="#work" class="btn btn-solid" data-magnetic>See the work <span aria-hidden="true">↓</span></a>
            <a href={SITE.contact} target="_blank" rel="noopener" class="btn" data-magnetic>
              Get in touch <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    {
      [0, 1].map(() => (
        <div class="ticker-track label">
          {tools.map((tool) => (
            <Fragment>
              <span class="whitespace-nowrap text-fg">{tool}</span>
              <span class="text-accent">/</span>
            </Fragment>
          ))}
        </div>
      ))
    }
  </div>

  <section id="work" class="wrap pt-20 md:pt-28">
    <div class="section-head" data-reveal>
      <h2 class="label">Selected work</h2>
      <span class="label">{count(work.length)}</span>
    </div>
    <WorkList items={work} />
  </section>

  <section class="wrap pt-28 md:pt-40">
    <div class="section-head" data-reveal>
      <h2 class="label">What I do</h2>
      <span class="label">{count(FOCUS.length)}</span>
    </div>
    <div class="grid md:grid-cols-3">
      {
        FOCUS.map((item, i) => (
          <div
            class="border-b border-line py-9 md:border-b-0 md:py-12 md:pr-10 md:[&:not(:first-child)]:border-l md:[&:not(:first-child)]:pl-10"
            data-reveal
            style={`--d:${i * 100}ms`}
          >
            <p class="label text-accent">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="display display-md mt-5">{item.title}</h3>
            <p class="mt-5 max-w-[40ch] text-[0.98rem] text-muted">{item.text}</p>
            <p class="label mt-7 leading-relaxed">{item.items.join(" / ")}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap pt-28 md:pt-40">
    <div class="grid gap-8 md:grid-cols-12">
      <h2 class="label md:col-span-3" data-reveal>About</h2>
      <div class="md:col-span-9">
        <Scrub
          class="font-display text-[clamp(1.55rem,3.1vw,2.9rem)] leading-[1.14] font-medium tracking-[-0.02em] [font-stretch:88%]"
          text="I'm an engineer in St. Catharines, Ontario, with five years across software development and production systems. I started as a developer, shipping React frontends, Spring Boot APIs and Stripe integrations. Today I debug inference services on Kubernetes, write the Python that triages failures automatically, and run a multi-agent system that investigates incidents before a human does."
        />
        <a href="/about" class="label link mt-10 inline-block text-fg" data-reveal>More about me →</a>
      </div>
    </div>
  </section>

  <section class="wrap pt-28 md:pt-40">
    <div class="section-head" data-reveal>
      <h2 class="label">Experience</h2>
      <span class="label">{count(EXPERIENCE.length)}</span>
    </div>
    <ol>
      {
        EXPERIENCE.map((job, i) => (
          <li class="grid gap-3 border-b border-line py-8 md:grid-cols-12 md:gap-6" data-reveal style={`--d:${i * 80}ms`}>
            <p class="label pt-1.5 md:col-span-3">{job.period}</p>
            <div class="md:col-span-4">
              <h3 class="display display-sm">{job.role}</h3>
              <p class="mt-2 text-[0.95rem] text-muted">
                {job.company} · {job.place}
              </p>
            </div>
            <p class="max-w-[52ch] text-[0.95rem] text-muted md:col-span-5">{job.summary}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    posts.length > 0 && (
      <section class="wrap pt-28 md:pt-40">
        <div class="section-head" data-reveal>
          <h2 class="label">Writing</h2>
          <span class="label">{count(posts.length)}</span>
        </div>
        <ul>
          {posts.slice(0, 3).map((post) => (
            <li data-reveal>
              <a href={`/blog/${post.id}/`} class="group grid gap-2 border-b border-line py-8 md:grid-cols-12 md:items-baseline md:gap-6">
                <span class="label md:col-span-3">{dateFormat.format(post.data.pubDate)}</span>
                <span class="display display-sm transition-colors duration-300 group-hover:text-accent md:col-span-8">
                  {post.data.title}
                </span>
                <span class="hidden text-right text-xl transition-transform duration-500 ease-expo group-hover:translate-x-1 group-hover:-translate-y-1 md:block" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
