---
import Base from "../layouts/Base.astro";
import Split from "../components/Split.astro";
import { EDUCATION, EXPERIENCE, TOOLKIT } from "../consts";
---

<Base
  title="About"
  description="Mir Sameer Irfan is an engineer in St. Catharines, Ontario, with five years across software development and production systems."
>
  <section class="wrap pt-16 md:pt-24">
    <p class="label" data-reveal>About</p>
    <Split
      as="h1"
      class="display display-xl mt-6 max-w-[15ch]"
      text="I build software. I also get called when it breaks."
      accent={["build"]}
    />

    <div class="mt-16 grid gap-8 md:mt-24 md:grid-cols-12">
      <p class="label md:col-span-3">Background</p>
      <div class="max-w-[62ch] space-y-6 text-[1.08rem] leading-[1.7] text-[#cfcdc7] md:col-span-9" data-reveal>
        <p>
          I'm an engineer based in St. Catharines, Ontario, with a computer science degree and five years across software
          development and production systems. I started as a developer in 2019, building React and TypeScript frontends
          and Java/Spring Boot APIs for client projects, and integrating Stripe payments that I then debugged in live
          production.
        </p>
        <p>
          At Accenture I work on an enterprise AI platform. When something fails, including inference services running
          in Docker on Kubernetes and talking over gRPC, I reproduce it, read the application code to find the failure
          logic, and query PostgreSQL directly. I resolve the majority of those cases without engineering involvement.
        </p>
        <p>
          I also build the tooling around that work. My Python scripts run triage, health inspection and data
          verification on every new ticket, and I built and operate a multi-agent investigation system in which parallel
          LLM agents read historical cases and procedures through MCP tools and surface a resolution path before a human
          starts.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap pt-28 md:pt-40">
    <div class="section-head" data-reveal>
      <h2 class="label">Experience</h2>
      <span class="label">({String(EXPERIENCE.length).padStart(2, "0")})</span>
    </div>
    <ol>
      {
        EXPERIENCE.map((job) => (
          <li class="grid gap-4 border-b border-line py-10 md:grid-cols-12 md:gap-6" data-reveal>
            <p class="label pt-1.5 md:col-span-3">{job.period}</p>
            <div class="md:col-span-9">
              <h3 class="display display-sm">{job.role}</h3>
              <p class="mt-2 text-[0.95rem] text-muted">
                {job.company} · {job.place}
              </p>
              <div class="prose mt-6 max-w-[68ch] !text-[0.98rem]">
                <ul>
                  {job.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap pt-28 md:pt-40">
    <div class="section-head" data-reveal>
      <h2 class="label">Toolkit</h2>
      <span class="label">({String(TOOLKIT.length).padStart(2, "0")})</span>
    </div>
    <div class="grid gap-x-6 gap-y-10 pt-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        TOOLKIT.map((group, i) => (
          <div data-reveal style={`--d:${i * 70}ms`}>
            <h3 class="label text-accent">{group.group}</h3>
            <ul class="mt-4 space-y-1.5 text-[0.95rem]">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap pt-28 md:pt-40">
    <div class="section-head" data-reveal>
      <h2 class="label">Education</h2>
      <span class="label">({String(EDUCATION.length).padStart(2, "0")})</span>
    </div>
    <ol>
      {
        EDUCATION.map((item) => (
          <li class="grid gap-3 border-b border-line py-8 md:grid-cols-12 md:gap-6" data-reveal>
            <p class="label pt-1.5 md:col-span-3">{item.period}</p>
            <div class="md:col-span-9">
              <h3 class="display display-sm">{item.title}</h3>
              <p class="mt-2 text-[0.95rem] text-muted">{item.school}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
