---
import Base from "../layouts/Base.astro";
import Split from "../components/Split.astro";
---

<Base title="Page not found" description="This page does not exist.">
  <section class="wrap flex min-h-[70svh] flex-col justify-center pt-16">
    <p class="label" data-reveal>Error 404</p>
    <Split as="h1" class="display display-xl mt-6 max-w-[14ch]" text="Nothing at this address." accent={["Nothing"]} />
    <p class="mt-8 max-w-[44ch] text-muted" data-reveal style="--d:300ms">
      The page may have moved, or the link was wrong to begin with.
    </p>
    <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--d:400ms">
      <a href="/" class="btn btn-solid">Back home</a>
      <a href="/work" class="btn">See the work</a>
    </div>
  </section>
</Base>
